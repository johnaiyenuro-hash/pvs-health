<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Weight Loss Vision 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f5f2ee;
    --card: #ffffff;
    --ink: #1c1917;
    --ink2: #57534e;
    --ink3: #a8a29e;
    --accent: #c84b2f;
    --accent2: #2563eb;
    --accent3: #16a34a;
    --border: #e7e5e4;
    --tag-p: #eff6ff; --tag-p-fg: #1d4ed8;
    --tag-c: #fff7ed; --tag-c-fg: #c2410c;
    --tag-f: #f0fdf4; --tag-f-fg: #15803d;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--ink); min-height: 100vh; line-height: 1.5; }

  /* Layout */
  .hero { padding: 40px 24px 28px; max-width: 800px; margin: 0 auto; }
  .hero-eyebrow { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); font-weight: 700; margin-bottom: 10px; }
  .hero h1 { font-family: 'Syne', sans-serif; font-size: clamp(32px, 8vw, 56px); font-weight: 800; line-height: 0.9; margin-bottom: 16px; }
  .hero h1 span { color: var(--accent); }
  .hero-sub { font-size: 15px; color: var(--ink2); max-width: 520px; }

  .tabs-wrap { max-width: 800px; margin: 0 auto; padding: 0 24px; position: sticky; top: 0; background: var(--bg); z-index: 100; padding-top: 10px; }
  .tabs { display: flex; gap: 8px; margin-bottom: 24px; overflow-x: auto; padding-bottom: 8px; scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  
  .tab { padding: 10px 20px; border-radius: 40px; border: 1.5px solid var(--border); font-size: 13px; cursor: pointer; background: white; font-weight: 600; transition: all 0.2s; white-space: nowrap; }
  .tab.active { background: var(--ink); color: white; border-color: var(--ink); }

  .content { max-width: 800px; margin: 0 auto; padding: 0 24px 80px; }
  .panel { display: none; animation: fadeIn 0.3s ease-out; }
  .panel.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .card { background: white; border-radius: 20px; border: 1.5px solid var(--border); padding: 24px; margin-bottom: 20px; }
  .card h3 { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 700; margin-bottom: 16px; }

  /* Nutrition & Macro Styles */
  .macro-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 24px; }
  .macro-box { text-align: center; padding: 16px; border-radius: 16px; border: 1.5px solid var(--border); }
  .macro-val { font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 800; }
  .macro-label { font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--ink3); letter-spacing: 1px; }
  
  .meal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 500px) { .meal-grid { grid-template-columns: 1fr; } }
  .meal-item { background: #fafaf9; border-radius: 14px; padding: 16px; border: 1px solid var(--border); }
  .meal-cat { font-size: 10px; font-weight: 800; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
  .meal-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 15px; margin-bottom: 8px; }
  .macro-tags { display: flex; gap: 6px; }
  .tag { font-size: 9px; font-weight: 700; padding: 2px 8px; border-radius: 4px; }
  .tag.p { background: var(--tag-p); color: var(--tag-p-fg); }
  .tag.c { background: var(--tag-c); color: var(--tag-c-fg); }
  .tag.f { background: var(--tag-f); color: var(--tag-f-fg); }

  /* Previous Styles preserved... */
  .day-card { background: white; border-radius: 16px; border: 1.5px solid var(--border); margin-bottom: 12px; overflow: hidden; }
  .day-header { padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
  .day-body { display: none; padding: 0 20px 20px; border-top: 1px solid var(--border); background: #fafaf9; }
  .day-body.open { display: block; }
  .ex-list { list-style: none; margin-top: 10px; font-size: 13px; }
  .pu-row { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
  .pu-cell { aspect-ratio: 1; background: white; border: 1.5px solid var(--border); border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; }
  .pu-cell.done { background: var(--ink); color: white; }
  .progress-bar { height: 8px; background: var(--border); border-radius: 10px; margin: 10px 0; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--accent3); width: 0%; transition: 0.4s; }
  .weight-input-group { display: flex; gap: 10px; margin-bottom: 20px; }
  input { padding: 12px; border-radius: 10px; border: 1.5px solid var(--border); width: 100%; }
  .btn-add { background: var(--ink); color: white; border: none; padding: 0 20px; border-radius: 10px; font-weight: 600; }
</style>
</head>
<body>

<div class="hero">
  <div class="hero-eyebrow">Vision 2026</div>
  <h1>Level Up<br><span>Fitness</span></h1>
  <p class="hero-sub">Fat Loss Strategy: 500kcal Deficit + Protein Focus</p>
</div>

<div class="tabs-wrap">
  <div class="tabs">
    <div class="tab active" onclick="showTab('dashboard', this)">Dashboard</div>
    <div class="tab" onclick="showTab('nutrition', this)">Nutrition</div>
    <div class="tab" onclick="showTab('workout', this)">Workout</div>
    <div class="tab" onclick="showTab('pushups', this)">Push-Ups</div>
    <div class="tab" onclick="showTab('log', this)">Weight Log</div>
  </div>
</div>

<div class="content">
  
  <!-- DASHBOARD -->
  <div class="panel active" id="dashboard">
    <div class="card">
      <h3>🎯 10kg Progress</h3>
      <div class="progress-bar"><div class="progress-fill" id="weightProgress"></div></div>
      <p id="weightStatus" style="font-size: 13px; color: var(--ink2);">Log your weight to start tracking.</p>
    </div>
    <div class="card" style="background: var(--ink); color: white; border: none;">
      <h3 style="color: white; margin-bottom: 8px;">Quick Rule of Thumb</h3>
      <p style="font-size: 14px; opacity: 0.9;">Eat 1.6g of protein per kg of bodyweight. If you weigh 80kg, aim for ~130g protein daily.</p>
    </div>
  </div>

  <!-- NUTRITION -->
  <div class="panel" id="nutrition">
    <div class="macro-container">
      <div class="macro-box" style="border-color: var(--tag-p-fg);">
        <div class="macro-label">Protein</div>
        <div class="macro-val" style="color: var(--tag-p-fg);">40%</div>
      </div>
      <div class="macro-box" style="border-color: var(--tag-c-fg);">
        <div class="macro-label">Carbs</div>
        <div class="macro-val" style="color: var(--tag-c-fg);">35%</div>
      </div>
      <div class="macro-box" style="border-color: var(--tag-f-fg);">
        <div class="macro-label">Fats</div>
        <div class="macro-val" style="color: var(--tag-f-fg);">25%</div>
      </div>
    </div>

    <div class="meal-grid">
      <div class="meal-item">
        <div class="meal-cat">Breakfast</div>
        <div class="meal-name">Protein Power Oats</div>
        <p style="font-size: 12px; color: var(--ink2); margin-bottom: 10px;">Oats, scoop of whey, 1tbsp peanut butter, berries.</p>
        <div class="macro-tags">
          <span class="tag p">High P</span><span class="tag c">Complex C</span>
        </div>
      </div>
      <div class="meal-item">
        <div class="meal-cat">Lunch</div>
        <div class="meal-name">Quinoa Chicken Bowl</div>
        <p style="font-size: 12px; color: var(--ink2); margin-bottom: 10px;">Grilled chicken, quinoa, spinach, cucumber, feta.</p>
        <div class="macro-tags">
          <span class="tag p">35g P</span><span class="tag f">Healthy F</span>
        </div>
      </div>
      <div class="meal-item">
        <div class="meal-cat">Dinner</div>
        <div class="meal-name">Salmon & Greens</div>
        <p style="font-size: 12px; color: var(--ink2); margin-bottom: 10px;">Baked salmon, roasted broccoli, half sweet potato.</p>
        <div class="macro-tags">
          <span class="tag p">Lean P</span><span class="tag f">Omega 3</span>
        </div>
      </div>
      <div class="meal-item">
        <div class="meal-cat">Snack</div>
        <div class="meal-name">Greek Yogurt Mix</div>
        <p style="font-size: 12px; color: var(--ink2); margin-bottom: 10px;">0% Greek yogurt, 10 almonds, cinnamon.</p>
        <div class="macro-tags">
          <span class="tag p">20g P</span><span class="tag f">Low Cal</span>
        </div>
      </div>
    </div>
  </div>

  <!-- WORKOUTS -->
  <div class="panel" id="workout">
    <div id="workoutList"></div>
  </div>

  <!-- PUSH-UPS -->
  <div class="panel" id="pushups">
    <div class="card">
      <h3>💪 Push-Up Challenge</h3>
      <div id="puGrid"></div>
    </div>
  </div>

  <!-- WEIGHT LOG -->
  <div class="panel" id="log">
    <div class="card">
      <h3>⚖️ Weight Log</h3>
      <div class="weight-input-group">
        <input type="number" id="weightInput" step="0.1" placeholder="Current weight (kg)">
        <button class="btn-add" onclick="addWeight()">Add</button>
      </div>
      <ul id="weightList" style="list-style:none;"></ul>
    </div>
  </div>

</div>

<script>
// Same logic as before with minor updates for new tab
const workouts = [
  { day: "Monday", focus: "Upper Body", ex: ["Push-ups: 3x15", "Bag Rows: 3x12", "Bench Dips: 3x12", "Plank: 3x60s"] },
  { day: "Tuesday", focus: "Legs + Run", ex: ["Squats: 3x20", "Lunges: 3x12/side", "Calf Raises: 3x20", "2km Steady Run"] },
  { day: "Wednesday", focus: "Core + HIIT", ex: ["Russian Twists: 3x20", "Mountain Climbers: 4x45s", "Leg Raises: 3x12", "Burpees: 3x10"] },
  { day: "Thursday", focus: "Push + Shoulders", ex: ["Pike Push-ups: 3x10", "Shoulder Taps: 3x20", "Diamond Push-ups: 3xMax", "2km Run (Optional)"] },
  { day: "Friday", focus: "Full Body", ex: ["Squat to Press: 3x15", "Bicep Curls (Bag): 3x12", "High Knees: 4x45s", "Superman: 3x12"] },
  { day: "Saturday", focus: "Active Recovery", ex: ["6k Walk", "Long Stretch Session", "Hip Mobility Drills"] },
  { day: "Sunday", focus: "Rest & Prep", ex: ["Meal Prep for Week", "Check Calorie Logs", "Relax"] }
];

const puSchedule = [10,12,15,0,18,20,22,0,25,28,30,0,32,35,40,0,45,50,55,60,75];

function showTab(id, el) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  el.classList.add('active');
}

// Render Workouts
const workoutList = document.getElementById('workoutList');
workouts.forEach((w, i) => {
  workoutList.innerHTML += `
    <div class="day-card">
      <div class="day-header" onclick="this.nextElementSibling.classList.toggle('open')">
        <div><div style="font-weight:700;">${w.day}</div><div style="font-size:12px;color:var(--accent);">${w.focus}</div></div>
        <span>▼</span>
      </div>
      <div class="day-body"><ul class="ex-list">${w.ex.map(e => `<li>${e}</li>`).join('')}</ul></div>
    </div>`;
});

// Push-ups
let puData = JSON.parse(localStorage.getItem('v26_pu') || '[]');
function renderPU() {
  const grid = document.getElementById('puGrid'); grid.innerHTML = '';
  let row;
  puSchedule.forEach((reps, i) => {
    if(i % 7 === 0) { row = document.createElement('div'); row.className = 'pu-row'; grid.appendChild(row); }
    const isDone = puData.includes(i);
    const cell = document.createElement('div');
    cell.className = `pu-cell ${isDone ? 'done' : ''}`;
    cell.innerHTML = reps === 0 ? '☕' : `<div style="font-size:9px;opacity:0.5;">${i+1}</div><div style="font-weight:800;">${reps}</div>`;
    cell.onclick = () => {
      if(puData.includes(i)) puData = puData.filter(d => d !== i); else puData.push(i);
      localStorage.setItem('v26_pu', JSON.stringify(puData)); renderPU();
    };
    row.appendChild(cell);
  });
}

// Weight Log
let weightLogs = JSON.parse(localStorage.getItem('v26_weights') || '[]');
function addWeight() {
  const val = document.getElementById('weightInput').value; if(!val) return;
  weightLogs.unshift({ date: new Date().toLocaleDateString(), kg: parseFloat(val) });
  localStorage.setItem('v26_weights', JSON.stringify(weightLogs));
  document.getElementById('weightInput').value = ''; renderWeights();
}

function renderWeights() {
  const list = document.getElementById('weightList'); list.innerHTML = '';
  weightLogs.forEach(log => {
    list.innerHTML += `<li style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);font-size:14px;"><span>${log.date}</span><strong>${log.kg} kg</strong></li>`;
  });
  if(weightLogs.length > 0) {
    const diff = (weightLogs[weightLogs.length-1].kg - weightLogs[0].kg).toFixed(1);
    const pct = Math.min(Math.max((diff / 10) * 100, 0), 100);
    document.getElementById('weightProgress').style.width = pct + '%';
    document.getElementById('weightStatus').textContent = `${diff}kg lost of 10kg goal (${pct.toFixed(1)}%)`;
  }
}

renderPU(); renderWeights();
</script>
</body>
</html>
